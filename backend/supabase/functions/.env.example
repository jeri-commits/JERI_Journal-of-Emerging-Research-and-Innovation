# Edge Function secrets. Never commit real values -- set them with:
#   supabase secrets set --env-file supabase/functions/.env.local
# (create that .env.local yourself; it's gitignored)
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically in
# production -- you only need to supply them for *local* `supabase
# functions serve` (copy them from `supabase status`).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (manuscript storage). From the Cloudflare dashboard:
# R2 -> Manage R2 API Tokens -> create a token scoped to this bucket only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Hostinger Business Email SMTP (same mailbox as the Supabase Auth SMTP
# config, or a different one -- your call).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=JERI Journal
SMTP_FROM_EMAIL=

# Used to build links inside notification emails.
PUBLIC_APP_URL=http://localhost:5173
